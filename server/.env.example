# Copy to server/.env and adjust as needed.

# PostgreSQL connection. The server creates its tables on start.
# Hosted databases (Neon, Supabase, Render, RDS...) usually need SSL: add ?sslmode=require
DATABASE_URL=postgres://newsquest:choose-a-password@localhost:5432/newsquest
# Optional: use this schema instead of "public" (lowercase letters, digits and underscores)
# DATABASE_SCHEMA=

# API port (the Vite dev server proxies /api to this port)
PORT=8787

# How often to poll the PIB / News On AIR RSS feeds (minutes, min 1)
FETCH_INTERVAL_MINUTES=5

# Delete live articles older than this many days
MAX_ARTICLE_AGE_DAYS=7

# Show the labelled offline demo archive when no live feed is reachable
DEMO_FALLBACK=true

# Timezone used for streaks / daily challenges
APP_TIMEZONE=Asia/Kolkata

# Full article text for richer summaries & more questions:
# off        - RSS text only
# ondemand   - fetched when a user presses "Deep Read" on an article (default)
# background - also fetched slowly in the background for new articles
FULL_TEXT_MODE=ondemand

# Set true when serving over HTTPS in production
COOKIE_SECURE=false

# Optional: any OpenAI-compatible endpoint for AI summaries & questions.
# Leave OPENAI_API_KEY empty to use the built-in offline NLP engine only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Automatically AI-enhance newly fetched articles (uses tokens!)
AI_AUTO_ENHANCE=false